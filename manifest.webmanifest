{
  "name": "ArPec Condição de Pastagem",
  "short_name": "ArPec Pasto",
  "description": "Avaliação de pastagens off-line – Escala Técnica ArPec",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f9f9f9",
  "theme_color": "#2c5f2d",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./receber",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivo",
          "accept": [
            "text/plain",
            ".txt",
            "application/json",
            ".json",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}